{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "test/**/*.ts",
      "test/**/*.tsx",
      "test/**/*.mjs",
      "*.json",
      ".github/rulesets/*.json",
      ".github/**/*.yml",
      "src/**/*.cts",
      "src/**/*.mjs",
      "src/**/*.mts",
      "src/**/*.css",
      "*.config.ts",
      "scripts/**/*.mjs",
      "scripts/**/*.cjs",
      ".devcontainer/*.json",
      ".devcontainer/*.mjs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/renderer/neobrutalism/theme.css"],
      "css": { "parser": { "tailwindDirectives": true } }
    }
  ]
}
