        background "#005d5d"
        color "#ffffff"
    }
    element "External" {
        background "#6f6f6f"
        color "#ffffff"
    }
    element "Container" {
        background "#007d79"
        color "#ffffff"
    }
    element "WebBrowser" {
        shape WebBrowser
        background "#0f62fe"
        color "#ffffff"
    }
    element "Backend" {
        background "#005d5d"
        color "#ffffff"
    }
    element "CLI" {
        background "#004144"
        color "#ffffff"
    }
    element "Sidecar" {
        background "#009d9a"
        color "#ffffff"
    }
    element "Worker" {
        background "#009d9a"
        color "#ffffff"
    }
    element "Helper" {
        background "#3ddbd9"
        color "#161616"
    }
    element "Database" {
        shape Cylinder
        background "#262626"
