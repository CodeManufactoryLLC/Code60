{
  "name": "Code60 Linux x64",
  "dockerComposeFile": "local/compose.json",
  "service": "code60",
  "runServices": ["cache-init", "code60"],
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "node",
  "updateRemoteUserUID": true,
  "userEnvProbe": "none",
  "overrideCommand": false,
  "shutdownAction": "none",
  "remoteEnv": {
    "SSH_AUTH_SOCK": "",
    "GPG_AGENT_INFO": "",
    "GIT_ASKPASS": "/bin/false",
    "GIT_TERMINAL_PROMPT": "0"
  },
  "forwardPorts": [43160, 43161],
  "portsAttributes": {
    "43160": { "label": "Code60", "protocol": "http", "requireLocalPort": true },
    "43161": {
      "label": "Vite / Fast Refresh",
      "protocol": "http",
      "requireLocalPort": true,
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "dev.containers.copyGitConfig": false,
        "dev.containers.gitCredentialHelperConfigLocation": "none",
        "remote.localPortHost": "localhost"
      }
    }
  }
}
