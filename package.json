{
  "name": "code60",
  "version": "0.2.0-beta.4",
  "private": true,
  "description": "Electron desktop app and headless CLI for orchestrating coding agents",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "code60": "dist/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:helper": "node scripts/build-windows-helper.mjs",
    "build": "node scripts/build-windows-helper.mjs && tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "node scripts/build-windows-helper.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "format": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "install:global": "npm ci && npm run build && npm link",
    "uninstall:global": "npm unlink -g code60",
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "test:desktop": "npm run build && playwright test",
    "test:desktop:container": "node scripts/test-desktop-container.mjs",
    "package:dir": "npm run build && node scripts/prepare-package.mjs && electron-builder --config scripts/packaging-config.cjs --dir --publish never",
    "package:linux": "npm run build && node scripts/prepare-package.mjs && electron-builder --config scripts/packaging-config.cjs --linux --x64 --publish never",
    "package:mac": "npm run build && node scripts/prepare-package.mjs && electron-builder --config scripts/packaging-config.cjs --mac --arm64 --publish never",
    "package:win": "node scripts/package-windows.mjs",
    "test:packaged": "playwright test --config playwright.packaged.config.ts",
    "test:installers": "node scripts/test-installers.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.4.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-serif": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@glideapps/glide-data-grid": "6.0.4-alpha24",
    "@headless-tree/core": "1.8.0",
    "@headless-tree/react": "1.8.0",
    "electron-updater": "^6.8.11",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.17"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.2.1",
    "electron-builder": "26.18.1",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "main": "dist/desktop/main.js",
  "author": {
    "name": "Code Manufactory LLC"
  },
  "homepage": "https://github.com/CodeManufactoryLLC/code60",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodeManufactoryLLC/code60.git"
  },
  "desktopName": "code60-desktop.desktop"
}
