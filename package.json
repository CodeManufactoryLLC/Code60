{
  "name": "code60",
  "version": "0.4.1",
  "private": true,
  "description": "Local browser application for orchestrating coding agents on macOS and Linux",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist",
    "models",
    "mcp.default.json",
    "LICENSE",
    "NOTICE",
    "TRADEMARKS.md"
  ],
  "scripts": {
    "prepare:models": "node scripts/prepare-models.mjs",
    "test:rag:model": "node scripts/prepare-models.mjs --verify && npm run build && node scripts/test-rag-model.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "node scripts/build-pty-helper.mjs",
    "test": "npm run build:distribution && vitest run",
    "test:watch": "vitest",
    "pretest:coverage": "node scripts/build-pty-helper.mjs",
    "test:coverage": "npm run build:distribution && vitest run --coverage && node scripts/check-coverage.mjs",
    "test:logs:performance": "npm run build && node scripts/benchmark-logs.mjs",
    "test:relay:performance": "npm run build && node scripts/benchmark-relay.mjs",
    "test:tactics:live": "npm run build && node scripts/evaluate-tactics.mjs",
    "check:unused": "knip",
    "check:instructions": "node scripts/check-instructions.mjs",
    "generate:capabilities": "vitest run test/capabilities.test.ts --update",
    "check:precommit": "npm run check:instructions && npm run typecheck && npm run lint && npm run check:unused",
    "hooks:install": "node scripts/git-hooks.mjs install",
    "hooks:status": "node scripts/git-hooks.mjs status",
    "hooks:uninstall": "node scripts/git-hooks.mjs uninstall",
    "lint": "biome check .",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "format": "biome check --write .",
    "check": "npm run check:instructions && npm run typecheck && npm run lint && npm run check:unused && npm run test:coverage",
    "dev": "node scripts/dev.mjs",
    "devcontainer": "node scripts/devcontainer.mjs",
    "start": "node dist/management/main.js open",
    "test:packaged": "node scripts/test-package.mjs",
    "test:mcp:native": "node scripts/test-mcp-native.mjs",
    "test:packaged:clean": "node scripts/test-clean-install.mjs",
    "test:packaged:concurrent": "node scripts/test-concurrent-clean-install.mjs",
    "test:memory:performance": "npm run build && node scripts/benchmark-memory.mjs",
    "service": "node dist/management/main.js service",
    "test:browser": "npm run build && playwright test",
    "package:app": "npm run build && node scripts/prepare-package.mjs && node scripts/package-app.mjs",
    "test:mcp:credentials": "node scripts/test-mcp-credentials-native.mjs",
    "package:payload": "npm run build && npm run build:distribution && node scripts/prepare-package.mjs && node scripts/package-payload.mjs",
    "package:bootstrap": "npm run build:distribution && node scripts/package-bootstrap.mjs",
    "test:payload": "node scripts/test-payload.mjs",
    "test:bootstrap": "node scripts/test-bootstrap.mjs",
    "build:distribution": "node scripts/build-distribution.mjs",
    "test:installation": "npm run build:distribution && node scripts/test-installation.mjs",
    "test:setup": "node scripts/test-setup.mjs",
    "test:uninstall": "node scripts/test-uninstall.mjs",
    "verify:artifact": "node scripts/verify-artifact-handoff.mjs",
    "test:update": "node scripts/test-update.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.4.0",
    "@carbon/ai-chat": "1.25.0",
    "@carbon/icons-react": "11.92.0",
    "@carbon/react": "1.121.0",
    "@carbon/web-components": "2.68.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@headless-tree/core": "1.8.0",
    "@headless-tree/react": "1.8.0",
    "@huggingface/transformers": "4.3.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/keyring": "2.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.17"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@carbon/styles": "1.120.0",
    "@devcontainers/cli": "0.91.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "knip": "6.47.0",
    "sass": "1.108.2",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  },
  "author": {
    "name": "Code Manufactory LLC"
  },
  "homepage": "https://github.com/CodeManufactoryLLC/code60",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodeManufactoryLLC/code60.git"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "code60": "dist/management/main.js"
  }
}
