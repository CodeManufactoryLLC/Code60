{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "allowJs": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.cts", "src/platform/*.mjs"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.test.mjs", "src/renderer/**"]
}
